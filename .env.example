# Google AI Studio API key (https://aistudio.google.com/apikey).
# Used for ad copy (works on the free tier) and Premium scenes (needs billing).
GEMINI_API_KEY=

# Free mode: Cloudflare Workers AI generates the empty background (10,000 free neurons/day).
# Account ID: Cloudflare dashboard > Workers AI (or any zone overview sidebar).
# Token: My Profile > API Tokens > Create Token > "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Optional: override models
# Image model used to re-render the product into a scene.
# Alternatives: gemini-3-pro-image (higher quality), gemini-3.1-flash-lite-image (cheaper)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Text model used to write the ad copy (English + Dhivehi)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Optional: if set, users must enter this code before generating (protects your API credits)
APP_ACCESS_CODE=
