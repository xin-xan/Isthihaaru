# Required: Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override models
# Image model used to re-render the product into a scene.
# Alternatives: gemini-3-pro-image (higher quality), gemini-3.1-flash-lite-image (cheaper)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Text model used to write the ad copy (English + Dhivehi)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Optional: if set, users must enter this code before generating (protects your API credits)
APP_ACCESS_CODE=
